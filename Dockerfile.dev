# Stage 1: Builder 阶段 - 准备 Python 依赖
FROM python:3.12-alpine AS builder

WORKDIR /app

# 安装 uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# 复制依赖描述
COPY pyproject.toml uv.lock ./

# 安装依赖到 /app/deps 目录
RUN uv pip install --no-cache --target /app/deps -r pyproject.toml

# Stage 2: Final 阶段 - 基于官方 Shairport-Sync 镜像 (自带 nqptp 与 AirPlay 2 支持)
FROM mikebrady/shairport-sync:latest

WORKDIR /app

# 安装 Python3 运行时
RUN apk add --no-cache python3

# 引入静态 FFmpeg
COPY --from=mwader/static-ffmpeg:6.1 /ffmpeg /ffprobe /usr/local/bin/

# 基础环境变量配置
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    MIPLAY_HOST= \
    WEB_PORT=8820 \
    MIPLAY_AIRPLAY2_DEV=1 \
    PYTHONPATH="/app/deps"

# 从 builder 阶段复制 Python 依赖
COPY --from=builder /app/deps /app/deps

# 复制项目源码与配置文件模板
COPY miplay/ ./miplay/
COPY miplay.py ./
COPY shairport-sync.conf ./

# 创建配置与管道目录
RUN mkdir -p /app/conf /tmp/shairport

EXPOSE 8820 53540-53550 7000 5000

# 容器启动脚本：后台拉起 nqptp 与 shairport-sync (由 Python 自动同步/etc/shairport-sync.conf)，随后启动 MiPlay
CMD ["sh", "-c", "nqptp & shairport-sync & python miplay.py"]
